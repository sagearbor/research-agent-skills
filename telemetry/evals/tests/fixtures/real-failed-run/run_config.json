{
  "config_file": "evals/config.yml",
  "harbor": {
    "environment": {
      "value": "docker",
      "source": "CLI"
    },
    "n_attempts": 1,
    "stop_on_pass": false,
    "n_concurrent": 2,
    "timeout_multiplier": 1.5,
    "base_image_mode": "disabled",
    "jobs_retained": false
  },
  "provider": {
    "name": "openai",
    "model": "gpt-5.6-sol"
  },
  "judge": {
    "enabled": true,
    "provider": "openai",
    "model": "gpt-5.6-sol",
    "source": "SKILL_EVAL_JUDGE_MODEL",
    "override_applied": true
  },
  "task_source": "evals_json",
  "grading": {
    "mode": "default_plus_custom"
  },
  "agents": {
    "codex": {
      "agent": "codex",
      "model": "gpt-5-nano",
      "source": "CLI"
    }
  }
}